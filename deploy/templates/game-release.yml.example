# Per-game release workflow template (docs/04-deployment-and-cicd.md).
# Copy to <game-repo>/.github/workflows/release.yml and replace every
# <GAME> / <game> placeholder: image name, compose service name, and the
# go-version-file path if it differs. ci.yml is identical across every
# repo (vet + build + go test -race ./...) — copy this repo's verbatim.
#
# Same shape as this repo's own release.yml: test (never skipped) →
# publish (needs: test) → deploy (needs: publish, environment-gated, and
# skips cleanly rather than failing loudly until DEPLOY_HOST is set for
# the production environment — see deploy/README.md in ssh-arcadelobby).
name: Release

on:
  push:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - run: go vet ./...
      - run: go build ./...
      - run: go test -race ./...

  publish:
    needs: test
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-buildx-action@v3
      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - id: meta
        run: echo "sha_short=sha-$(git rev-parse --short HEAD)" >> "$GITHUB_OUTPUT"
      - uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: |
            ghcr.io/mynameis-nigel/<repo>:latest
            ghcr.io/mynameis-nigel/<repo>:${{ steps.meta.outputs.sha_short }}

  deploy:
    needs: publish
    runs-on: ubuntu-latest
    environment: production
    steps:
      - name: Check deploy is configured
        id: check
        run: |
          if [ -z "${{ vars.DEPLOY_HOST }}" ]; then
            echo "::notice::DEPLOY_HOST not set for the production environment — skipping deploy."
            echo "configured=false" >> "$GITHUB_OUTPUT"
          else
            echo "configured=true" >> "$GITHUB_OUTPUT"
          fi
      - if: steps.check.outputs.configured == 'true'
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ vars.DEPLOY_HOST }}
          username: deploy
          key: ${{ secrets.DEPLOY_SSH_KEY }}
          script: |
            cd /srv/ssharcade
            docker compose pull <service>
            docker compose up -d <service>
