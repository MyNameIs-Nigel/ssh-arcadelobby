# ssharcade.dev edge — the apex redirect, plus the one-file player-count
# API at api.ssharcade.dev (bottom of this file). Still no site content on
# this host.
#
# WHY THIS EXISTS: DNS has no notion of ports. One A record for a name
# serves both the SSH router on 22 and anything listening on 80/443, so
# `ssh ssharcade.dev` requires the apex A record to point at this host's
# Elastic IP — which in turn means something here has to answer browsers,
# or the website 404s. That something is this file.
#
# The website itself stays on Vercel at www.ssharcade.dev. This box only
# bounces browsers there, so the site keeps its CDN, its preview deploys
# and its free egress, and this host serves ~250 bytes per visit instead
# of the whole site. Deliberately NOT a `file_server`: see deploy/README.md
# ("Serving the site from the box instead") for what changes if that ever
# becomes the goal.
#
# DEPLOYED COPY: /srv/ssharcade/Caddyfile, synced by ssh-arcadelobby's
# release.yml alongside docker-compose.yml and games.toml. Edits made
# directly on the host are overwritten by the next router release — unlike
# banner/banner.toml, this is code, not operator-edited content.

# There is deliberately no global options block.
#
#   * The admin API keeps its default bind (127.0.0.1:2019). That is the
#     *container's* loopback — reachable only from inside this container's
#     network namespace, not from the host and not from the ssharcade
#     network — so leaving it on costs nothing, and it is what makes the
#     zero-downtime `caddy reload` in release.yml's deploy job work.
#     `admin off` would break that reload.
#
#   * No `email`. Let's Encrypt does not require one, and threading it in
#     as {$ACME_EMAIL} is a footgun: an unset var expands to nothing and
#     `email` with no argument is a parse error, so a missing host-side
#     .env would fail the whole config rather than degrade. Add a literal
#     address inside the block below if you want expiry notices.
#
# Dry-running a DNS cutover: uncomment this block to use the staging CA so
# failed validations don't burn Let's Encrypt's real rate limits, then
# comment it out again and reload. Staging certs are untrusted by browsers
# — this is for proving the ACME path works, not for going live.
#
# {
# 	acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
# }

# Apex. `permanent` is a 301, correct for apex→www and what search engines
# want. Know the trade-off before changing the plan: browsers cache a 301
# hard and effectively forever, so if this host later serves the site
# itself, everyone who has visited will keep being sent to www until their
# cache is cleared. While the apex/www split is still being decided,
# `temporary` (302) is the reversible choice.
ssharcade.dev {
	redir https://www.ssharcade.dev{uri} permanent
}

# Live player-count API (docs/07-live-player-count.md). One static JSON file,
# written every few seconds by the router into the shared `arcade-stats`
# volume and served here read-only. This keeps the property the apex block
# depends on: Caddy stays on the `edge` network with no route to the router
# or the games — the volume is the only thing the two containers share, and
# all it can ever hold is public counts.
#
# ORDERING: add the `api.ssharcade.dev` A record (same Elastic IP as the
# apex) and let it propagate BEFORE this block reaches the host, for the
# same ACME reason as the apex — see deploy/README.md, "Live player-count
# API".
api.ssharcade.dev {
	header {
		# Public, read-only data meant for browsers on www.ssharcade.dev and
		# its Vercel preview deploys, so no origin allow-list to maintain.
		# A plain GET with no custom headers needs no preflight.
		Access-Control-Allow-Origin *
		# Date is not CORS-safelisted, so browser JS cannot read it unless
		# exposed. Clients need it to age the snapshot against this host's
		# clock rather than their own, which may be minutes off.
		Access-Control-Expose-Headers Date
		# Shorter than the router's 5s write interval: a CDN or browser
		# can absorb a burst, but never serve a count more than one write
		# behind.
		Cache-Control "public, max-age=4"
		X-Content-Type-Options nosniff
	}

	handle /v1/players {
		root * /srv/stats
		# Named explicitly so nothing else in the volume — including the
		# router's dot-named temp files mid-write — is ever reachable.
		rewrite * /players.json
		file_server
	}

	handle {
		respond 404
	}
}
